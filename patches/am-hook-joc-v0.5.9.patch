+      dataset.append(el('option', { value: name, textContent: name }));
+    }
+    dataset.value = value.dataset;
+    dataset.setAttribute('aria-label', t('set.jocDataset'));
+    dataset.addEventListener('change', () => set({ dataset: dataset.value }));
+    const datasetDesc = el('span', { className: 'set-desc' },
+      document.createTextNode(t('set.jocDatasetDesc') + ' '),
+      el('a', {
+        href: 'https://www.york.ac.uk/sadie-project/database.html',
+        target: '_blank',
+        rel: 'noopener noreferrer',
+        textContent: t('set.jocDatasetLink'),
+      }));
+    const datasetRow = el('div', { className: 'set-row' },
+      el('span', { className: 'set-label' },
+        el('span', { textContent: t('set.jocDataset') }), datasetDesc),
+      el('div', { className: 'set-control' }, dataset));
+
+    group.append(el('div', { className: 'set-card' },
+      row(t('set.jocMode'), t('set.jocModeDesc'), modeGroup),
+      gainRow,
+      datasetRow));
+    host.replaceChildren(group);
+  }
+
+  render();
+  probeHrtf(signal).then((result) => {
+    if (disposed) return;
+    hrtf = result;
+    render();
+  });
+
+  const offPrefs = prefs.onChange((section) => { if (section === 'joc') render(); });
+  const offLang = AmI18n.onChange(render);
+  signal.addEventListener('abort', () => { disposed = true; offPrefs(); offLang(); }, { once: true });
+}
