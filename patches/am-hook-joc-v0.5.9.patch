diff -ruN '--exclude=.DS_Store' a/src/ui/joc-decode-worker.js b/src/ui/joc-decode-worker.js
--- a/src/ui/joc-decode-worker.js	1970-01-01 08:00:00.000000000 +0800
+++ b/src/ui/joc-decode-worker.js	2026-10-24 17:31:10.497846100 +0800
@@ -0,0 +1,374 @@
+// E-AC-3 JOC decode + render worker. One thread does everything: the EC-3
+// decoder (am-hook's ec3.wasm) produces the core PCM, the JOC module
+// (joc.wasm, built from joc-wasm/) reconstructs the objects and renders them.
+//
+// The main thread sends one fMP4 fragment at a time and receives one interleaved
+// stereo buffer, which it schedules on Web Audio. Decoder and renderer state stay
+// in this worker, so a seek is a reset plus a pre-roll, exactly like the C++
+// streaming API.
+import createEc3 from '/assets/ec3-runtime.mjs';
+
+let modulePromise = null;
+let ec3 = null;
+let ctx = 0;
+let joc = null;
+let handle = 0;
+let rate = 48000;
+let pendingSkip = 0;
+let outPtr = 0;
+let pcmPtr = 0;
+let pcmCapacity = 0;
+let mode = 0;
+const HRTF_URLS = {
+  D1: '/assets/joc-hrtf-D1.jochrtf',
+  D2: '/assets/joc-hrtf-D2.jochrtf',
+  H3: '/assets/joc-hrtf-H3.jochrtf',
+  H4: '/assets/joc-hrtf-H4.jochrtf',
+  H5: '/assets/joc-hrtf-H5.jochrtf',
+  H6: '/assets/joc-hrtf-H6.jochrtf',
+  H7: '/assets/joc-hrtf-H7.jochrtf',
+  H8: '/assets/joc-hrtf-H8.jochrtf',
+  H9: '/assets/joc-hrtf-H9.jochrtf',
+  H10: '/assets/joc-hrtf-H10.jochrtf',
+  H11: '/assets/joc-hrtf-H11.jochrtf',
+  H12: '/assets/joc-hrtf-H12.jochrtf',
+  H13: '/assets/joc-hrtf-H13.jochrtf',
+  H14: '/assets/joc-hrtf-H14.jochrtf',
+  H15: '/assets/joc-hrtf-H15.jochrtf',
+  H16: '/assets/joc-hrtf-H16.jochrtf',
+  H17: '/assets/joc-hrtf-H17.jochrtf',
+  H18: '/assets/joc-hrtf-H18.jochrtf',
+  H19: '/assets/joc-hrtf-H19.jochrtf',
+  H20: '/assets/joc-hrtf-H20.jochrtf',
+};
+let dataset = 'D2';
+let gainDb = 0;
+
+function boxes(bytes, start = 0, end = bytes.length) {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const out = [];
+  for (let p = start; p + 8 <= end;) {
+    let size = view.getUint32(p);
+    const type = String.fromCharCode(...bytes.subarray(p + 4, p + 8));
+    let header = 8;
+    if (size === 1) { size = Number(view.getBigUint64(p + 8)); header = 16; }
+    else if (size === 0) size = end - p;
+    if (size < header || p + size > end) throw new Error(`Invalid MP4 ${type} box`);
+    out.push({ type, start: p, body: p + header, end: p + size });
+    p += size;
+  }
+  return out;
+}
+
+function child(bytes, parent, type) {
+  const box = boxes(bytes, parent.body, parent.end).find((entry) => entry.type === type);
+  if (!box) throw new Error(`Missing MP4 ${type} box`);
+  return box;
+}
+
+function top(bytes, type) { return child(bytes, { body: 0, end: bytes.length }, type); }
+
+function samplesFromFragment(bytes) {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const moof = top(bytes, 'moof');
+  const traf = child(bytes, moof, 'traf');
+  const tfhd = child(bytes, traf, 'tfhd');
+  const flags = view.getUint32(tfhd.body) & 0xffffff;
+  let cursor = tfhd.body + 8;
+  if (flags & 0x01) cursor += 8;
+  if (flags & 0x02) cursor += 4;
+  const defaultSize = flags & 0x10 ? view.getUint32(cursor + (flags & 0x08 ? 4 : 0)) : 0;
+  const samples = [];
+  let nextData = top(bytes, 'mdat').body;
+  for (const trun of boxes(bytes, traf.body, traf.end).filter((box) => box.type === 'trun')) {
+    const runFlags = view.getUint32(trun.body) & 0xffffff;
+    const count = view.getUint32(trun.body + 4);
+    if (count > 100000) throw new Error('Too many EC-3 samples');
+    let pos = trun.body + 8;
+    let data = nextData;
+    if (runFlags & 0x01) { data = moof.start + view.getInt32(pos); pos += 4; }
+    if (runFlags & 0x04) pos += 4;
+    for (let i = 0; i < count; i++) {
+      if (runFlags & 0x100) pos += 4;
+      const size = runFlags & 0x200 ? view.getUint32(pos) : defaultSize;
+      if (runFlags & 0x200) pos += 4;
+      if (runFlags & 0x400) pos += 4;
+      if (runFlags & 0x800) pos += 4;
+      if (!size || pos > trun.end || data < 0 || data + size > bytes.length) throw new Error('Invalid EC-3 sample range');
+      samples.push(bytes.subarray(data, data + size));
+      data += size;
+    }
+    nextData = data;
+  }
+  if (!samples.length) throw new Error('No EC-3 samples in fragment');
+  return samples;
+}
+
+function jocError() {
+  const ptr = joc.exports.joc_error_ptr();
+  const len = joc.exports.joc_error_len();
+  const text = new TextDecoder().decode(new Uint8Array(joc.exports.memory.buffer, ptr, len));
+  return text || 'JOC renderer error';
+}
+
+async function ensureEc3() {
+  if (!ec3) {
+    if (!modulePromise) {
+      modulePromise = fetch('/assets/ec3.wasm').then(async (response) => {
+        if (!response.ok) throw new Error(`EC-3 WASM HTTP ${response.status}`);
+        const wasmBinary = new Uint8Array(await response.arrayBuffer());
+        return createEc3({ wasmBinary });
+      });
+    }
+    const module = await modulePromise;
+    const wrap = (name, args) => module.cwrap(name, 'number', args);
+    ec3 = {
+      module,
+      open: wrap('init_decoder', ['number']),
+      packet: wrap('configure_decode_packet', ['number', 'number']),
+      decode: wrap('decode_packet', ['number', 'bigint']),
+      format: wrap('get_decoded_format', ['number']),
+      plane: wrap('get_decoded_plane_ptr', ['number', 'number']),
+      channels: wrap('get_decoded_channels', ['number']),
+      rate: wrap('get_decoded_sample_rate', ['number']),
+      count: wrap('get_decoded_sample_count', ['number']),
+      flush: wrap('flush_decoder', ['number']),
+      close: wrap('close_decoder', ['number']),
+    };
+  }
+  if (!ctx) {
+    ctx = ec3.open(1); // 1 = E-AC-3
+    if (!ctx) throw new Error('Cannot open the EC-3 decoder');
+  }
+  return ec3;
+}
+
+async function ensureJoc() {
+  if (!joc) {
+    const response = await fetch('/assets/joc.wasm');
+    if (!response.ok) throw new Error(`JOC WASM HTTP ${response.status}`);
+    const bytes = await response.arrayBuffer();
+    // A buffer source resolves to { module, instance }.
+    const { instance } = await WebAssembly.instantiate(bytes, {});
+    joc = instance;
+    const capacity = 16 * 1536;
+    pcmPtr = joc.exports.joc_alloc(capacity * 4);
+    pcmCapacity = capacity;
+    outPtr = joc.exports.joc_alloc(8192 * 4);
+  }
+  return joc;
+}
+
+function allocBytes(length) {
+  const ptr = joc.exports.joc_alloc(length);
+  if (!ptr) throw new Error('JOC WASM allocation failed');
+  return ptr;
+}
+
+async function openStream(options) {
+  await ensureEc3();
+  await ensureJoc();
+  if (handle) { joc.exports.joc_close(handle); handle = 0; }
+  mode = options.mode === 'binaural' ? 1 : 0;
+  gainDb = Number(options.gainDb) || 0;
+  dataset = String(options.dataset || 'D2').replace(/[^A-Za-z0-9]/g, '') || 'D2';
+  let hrtfPtr = 0;
+  let hrtfLength = 0;
+  let hrtfError = '';
+  if (mode === 1) {
+    try {
+      const response = await fetch(HRTF_URLS[dataset] || HRTF_URLS.D2);
+      if (!response.ok) throw new Error(`HTTP ${response.status}`);
+      const bytes = new Uint8Array(await response.arrayBuffer());
+      hrtfPtr = allocBytes(bytes.length);
+      new Uint8Array(joc.exports.memory.buffer, hrtfPtr, bytes.length).set(bytes);
+      hrtfLength = bytes.length;
+    } catch (error) {
+      hrtfError = error.message || String(error);
+    }
+  }
+  handle = joc.exports.joc_open(
+    mode, gainDb, 1 /* mid */, 1473, 5.0, hrtfPtr, hrtfLength,
+  );
+  if (hrtfPtr) joc.exports.joc_free(hrtfPtr, hrtfLength);
+  if (!handle) {
+    const message = jocError();
+    if (mode === 1) throw new Error(`Binaural HRTF unavailable: ${hrtfError || message}`);
+    throw new Error(message);
+  }
+  pendingSkip = 0;
+  return { hrtf: mode === 0 ? true : !hrtfError, hrtfError };
+}
+
+function restartDecoder() {
+  if (!ec3) return;
+  if (ctx) { ec3.close(ctx); ctx = 0; }
+  // A seek restarts the core decoder as well: its overlap state belongs to the
+  // old position, and the pre-roll frames rebuild it.
+  ctx = ec3.open(1);
+  if (!ctx) throw new Error('Cannot reopen the EC-3 decoder');
+}
+
+function pullFrames() {
+  const chunks = [];
+  let total = 0;
+  for (;;) {
+    const produced = joc.exports.joc_pull(handle, outPtr, 4096);
+    if (produced < 0) throw new Error(jocError());
+    if (produced === 0) break;
+    const view = new Float32Array(joc.exports.memory.buffer, outPtr, produced * 2);
+    chunks.push(view.slice());
+    total += produced;
+  }
+  return { chunks, total };
+}
+
+function decodeFragment(buffer) {
+  const started = performance.now();
+  const packets = samplesFromFragment(new Uint8Array(buffer));
+  const chunks = [];
+  let skipped = 0;
+  for (const packet of packets) {
+    const ptr = ec3.packet(ctx, packet.length);
+    if (!ptr) throw new Error('EC-3 packet allocation failed');
+    ec3.module.HEAPU8.set(packet, ptr);
+    const result = ec3.decode(ctx, 0n);
+    if (result < 0) throw new Error(`EC-3 decode failed (${result})`);
+    if (ec3.format(ctx) !== 8) throw new Error('EC-3 decoder returned non-planar float PCM');
