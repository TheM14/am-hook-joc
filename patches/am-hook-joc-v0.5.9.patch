+        return;
+      }
+      default:
+        throw new Error(`Unknown JOC worker operation ${data.op}`);
+    }
+  } catch (error) {
+    self.postMessage({ id: data.id, ok: false, error: error.message || String(error) });
+  }
+};
diff -ruN '--exclude=.DS_Store' a/src/ui/joc-probe.mjs b/src/ui/joc-probe.mjs
--- a/src/ui/joc-probe.mjs	1970-01-01 08:00:00.000000000 +0800
+++ b/src/ui/joc-probe.mjs	2026-10-24 17:31:10.497846100 +0800
@@ -0,0 +1,30 @@
+// Probes the bundled HRTF without touching playback: opens a JOC stream in
+// binaural mode inside the real worker, reports success or the loader's error,
+// and closes it again. Settings uses this to state whether binaural is possible.
+
+export function probeHrtf(signal) {
+  return new Promise((resolve) => {
+    let worker;
+    let timer;
+    const done = (result) => {
+      clearTimeout(timer);
+      if (worker) worker.terminate();
+      resolve(result);
+    };
+    try {
+      worker = new Worker('/assets/joc-decode-worker.js', { type: 'module' });
+    } catch (error) {
+      resolve({ ok: false, error: String(error) });
+      return;
+    }
+    timer = setTimeout(() => done({ ok: false, error: 'timeout' }), 20000);
+    worker.onmessage = ({ data }) => {
+      if (data.id !== 1) return;
+      if (data.ok) done({ ok: true, result: data.result });
+      else done({ ok: false, error: data.error });
+    };
+    worker.onerror = (event) => done({ ok: false, error: event.message || 'worker error' });
+    signal?.addEventListener('abort', () => done({ ok: false, error: 'aborted' }), { once: true });
+    worker.postMessage({ id: 1, op: 'open', mode: 'binaural', gainDb: -4 });
+  });
+}
